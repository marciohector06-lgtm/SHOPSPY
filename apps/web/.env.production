# Fallback de build para produção (Vercel) — só é aplicado se a env var não
# estiver já definida no dashboard do Vercel (Next.js nunca sobrescreve uma
# process.env já existente com o valor de um arquivo .env). Sem chave/segredo
# aqui, só a URL pública da API — por isso é seguro commitar.
NEXT_PUBLIC_API_URL=https://shopspy-production.up.railway.app
